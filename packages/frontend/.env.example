# Copy this file to packages/frontend/.env.
# Do not put these settings in .env.local; Rayfin generates and manages that file.
# These values are public browser configuration, NOT secrets. Never add a client secret.

# Required: directory (tenant) GUID for your single-tenant Entra app registration.
VITE_ADMIN_TENANT_ID=
# Required: application (client) GUID for that SPA registration.
VITE_ADMIN_CLIENT_ID=
# Required: canonical hosted origin, without a path, query, hash, or trailing slash.
# Use HTTPS. HTTP is allowed only for localhost or 127.0.0.1 during development.
# Register the corresponding SPA redirect URI: <origin>/admin-auth.html.
# A first deployment may leave these blank and show a setup-required shell.
# After obtaining the hosting origin, configure this file, rebuild, and redeploy.
VITE_ADMIN_HOSTED_ORIGIN=

# Optional display labels only; they do not select or authorize a tenant/workspace.
VITE_TENANT_LABEL=
VITE_WORKSPACE_LABEL=
